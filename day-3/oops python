# 5. DEMONSTRATION / EXECUTION
# ==========================================-
if __name__ == "__main__":
    # Create Bank
    first_national = Bank("First National Bank")

    # Instantiate Concrete Accounts
    savings = SavingsAccount(account_number="SA-1001", owner="Rohtih sai", initial_balance=1000.0, interest_rate=0.04)
    checking = CheckingAccount(account_number="CA-2002", owner="Sanjay", initial_balance=200.0, overdraft_limit=300.0)

    # Open accounts in the bank
    first_national.open_account(savings)
    first_national.open_account(checking)

    # Perform Operations
    print("\n--- Performing Transactions ---")
    savings.deposit(500.0)

    # Checking overdraft capability
    checking.withdraw(350.0)  # Drops balance to -$150.00 (within $300 overdraft limit)

    # Execute polymorphic monthly updates
    first_national.process_monthly_cycles()

    # View full transaction histories
    first_national.print_statement("SA-1001")
    first_national.print_statement("CA-2002")