from abc import ABC, abstractmethod
from datetime import datetime
from typing import List, Optional


# ==========================================
# 1. TRANSACTIONS & ENCAPSULATION
# ==========================================-
class Transaction:
    """Represents an immutable record of a bank transaction."""

    def __init__(self, tx_type: str, amount: float):
        self._timestamp = datetime.now()
        self._tx_type = tx_type
        self._amount = amount

    @property
    def timestamp(self) -> str:
        return self._timestamp.strftime("%Y-%m-%d %H:%M:%S")

    @property
    def tx_type(self) -> str:
        return self._tx_type

    @property
    def amount(self) -> float:
        return self._amount

    def __repr__(self) -> str:
        return f"Transaction(type='{self.tx_type}', amount={self.amount:.2f})"

    def __str__(self) -> str:
        return f"[{self.timestamp}] {self.tx_type.upper()}: {self.amount:.2f}"


# ==========================================
# 2. ABSTRACT BASE CLASS (ABSTRACTION)
# ==========================================-
class Account(ABC):
    """Abstract Base Class for all bank accounts."""

    def __init__(self, account_number: str, owner: str, initial_balance: float = 0.0):
        if initial_balance < 0:
            raise ValueError("Initial balance cannot be negative.")

        self._account_number = account_number
        self.owner = owner
        self._balance = initial_balance
        self._history: List[Transaction] = []

        if initial_balance > 0:
            self._history.append(Transaction("Initial Deposit", initial_balance))

    # Encapsulated Properties (Read-Only accessors)
    @property
    def account_number(self) -> str:
        return self._account_number

    @property
    def balance(self) -> float:
        return self._balance

    # Abstract Method interface enforcing polymorphism
    @abstractmethod
    def apply_monthly_processing(self) -> None:
        """Processes monthly updates (e.g., interest accrual, maintenance fees)."""
        pass

    def deposit(self, amount: float) -> float:
        """Deposits funds into the account."""
        if amount <= 0:
            raise ValueError("Deposit amount must be strictly positive.")

        self._balance += amount
        self._history.append(Transaction("Deposit", amount))
        return self._balance

    def withdraw(self, amount: float) -> float:
        """Base withdrawal logic with balance checking."""
        if amount <= 0:
            raise ValueError("Withdrawal amount must be strictly positive.")
        if amount > self._balance:
            raise ValueError("Insufficient funds for withdrawal.")

        self._balance -= amount
        self._history.append(Transaction("Withdrawal", amount))
        return self._balance

    # Dunder Methods
    def __str__(self) -> str:
        return f"{self.__class__.__name__} #{self.account_number} ({self.owner}) - Balance: {self.balance:.2f}"

    def __repr__(self) -> str:
        return f"{self.__class__.__name__}(account_number='{self.account_number}', owner='{self.owner}', balance={self.balance})"

    def __len__(self) -> int:
        """Returns the total number of recorded transactions."""
        return len(self._history)

    def __eq__(self, other: object) -> bool:
        """Accounts are equal if they have the same account number."""
        if not isinstance(other, Account):
            return False
        return self.account_number == other.account_number


# ==========================================-
# 3. INHERITANCE & METHOD OVERRIDING
# ==========================================-
class SavingsAccount(Account):
    """Savings account with interest accrual and withdrawal limits."""

    def __init__(self, account_number: str, owner: str, initial_balance: float = 0.0, interest_rate: float = 0.03):
        super().__init__(account_number, owner, initial_balance)
        self.interest_rate = interest_rate  # 0.03 = 3% annual interest

    def apply_monthly_processing(self) -> None:
        """Accrues monthly interest based on annual rate."""
        monthly_interest = self.balance * (self.interest_rate / 12)
        self._balance += monthly_interest
        self._history.append(Transaction("Interest Payment", monthly_interest))


class CheckingAccount(Account):
    """Checking account featuring overdraft protection and transaction fees."""

    def __init__(self, account_number: str, owner: str, initial_balance: float = 0.0, overdraft_limit: float = 500.0):
        super().__init__(account_number, owner, initial_balance)
        self.overdraft_limit = overdraft_limit

    # Overriding method to allow overdrafts
    def withdraw(self, amount: float) -> float:
        if amount <= 0:
            raise ValueError("Withdrawal amount must be strictly positive.")

        if amount > (self._balance + self.overdraft_limit):
            raise ValueError(f"Exceeds overdraft limit of {self.overdraft_limit:.2f}.")

        self._balance -= amount
        self._history.append(Transaction("Withdrawal (Checking)", amount))
        return self._balance

    def apply_monthly_processing(self) -> None:
        """Applies a flat maintenance fee if balance falls below zero."""
        if self.balance < 0:
            fee = 25.00
            self._balance -= fee
            self._history.append(Transaction("Overdraft Fee", fee))


# ==========================================-
# 4. POLYMORPHISM & BANK MANAGEMENT SYSTEM
# ==========================================-
class Bank:
    """Manages collection of abstract Account objects using Polymorphism."""

    def __init__(self, name: str):
        self.name = name
        self._accounts: List[Account] = []

    def open_account(self, account: Account) -> None:
        if account in self._accounts:
            raise ValueError("Account number already exists in system.")
        self._accounts.append(account)
        print(f"Opened: {account}")

    def process_monthly_cycles(self) -> None:
        """Polymorphically processes all accounts regardless of their concrete type."""
        print(f"\n--- Running Monthly Processing for {self.name} ---")
        for acc in self._accounts:
            acc.apply_monthly_processing()
            print(f"Processed: {acc}")

    def print_statement(self, account_number: str) -> None:
        """Prints transaction audit log for a specific account."""
        acc = next((a for a in self._accounts if a.account_number == account_number), None)
        if not acc:
            print("Account not found.")
            return

        print(f"\n==========================================")
        print(f"STATEMENT FOR: {acc.owner} ({acc.account_number})")
        print(f"TYPE: {acc.__class__.__name__}")
        print(f"CURRENT BALANCE: {acc.balance:.2f}")
        print(f"TOTAL TRANSACTIONS: {len(acc)}")
        print(f"------------------------------------------")
        for tx in acc._history:
            print(tx)
        print(f"==========================================\n")


