# ========================================================
# E-COMMERCE FULL STACK DOCKER & LOCAL CONFIGURATION
# ========================================================

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=ecommerce_db

# Security & JWT Tokens
SECRET_KEY=change-this-to-a-super-secret-random-jwt-token-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration (Optional for invoice & auth emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# External AI Provider API Keys (Optional)
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
