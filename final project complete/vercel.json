{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd ecommerce_frontend && npm install && npm run build",
  "outputDirectory": "ecommerce_frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/ecommerce_frontend/dist/index.html"
    }
  ]
}
