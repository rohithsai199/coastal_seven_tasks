import json
import os

FILE_PATH = "contacts.json"

def load_contacts() -> dict:
    """Loads contacts from JSON file; creates one if missing or corrupted."""
    if not os.path.exists(FILE_PATH):
        return {}
    try:
        with open(FILE_PATH, "r") as file:
            return json.load(file)
    except (FileNotFoundError, json.JSONDecodeError):
        print("Warning: Could not read contacts file. Starting fresh.")
        return {}

def save_contacts(contacts: dict) -> None:
    """Saves contacts dictionary to JSON file."""
    try:
        with open(FILE_PATH, "w") as file:
            json.dump(contacts, file, indent=4)
        print("Contacts saved successfully.")
    except IOError as e:
        print(f"Error saving file: {e}")

def add_contact(contacts: dict) -> None:
    name = input("Enter name: ").strip()
    if name in contacts:
        print("Contact already exists!")
        return
    phone = input("Enter phone: ").strip()
    email = input("Enter email: ").strip()
    contacts[name] = {"phone": phone, "email": email}
    save_contacts(contacts)

def view_contacts(contacts: dict) -> None:
    if not contacts:
        print("No contacts found.")
        return
    print("\n--- CONTACT LIST ---")
    for name, info in contacts.items():
        print(f"Name: {name} | Phone: {info.get('phone')} | Email: {info.get('email')}")

def delete_contact(contacts: dict) -> None:
    name = input("Enter contact name to delete: ").strip()
    if name in contacts:
        del contacts[name]
        save_contacts(contacts)
        print(f"Deleted contact: {name}")
    else:
        print("Contact not found.")

def main():
    contacts = load_contacts()
    while True:
        print("\n--- Contact Book ---")
        print("1. View Contacts")
        print("2. Add Contact")
        print("3. Delete Contact")
        print("4. Exit")
        
        choice = input("Select an option (1-4): ").strip()
        if choice == "1":
            view_contacts(contacts)
        elif choice == "2":
            add_contact(contacts)
        elif choice == "3":
            delete_contact(contacts)
        elif choice == "4":
            print("Goodbye!")
            break
        else:
            print("Invalid selection. Try again.")

if __name__ == "__main__":
    main()