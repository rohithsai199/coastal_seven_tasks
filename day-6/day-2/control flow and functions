#*kwargs*args

def flexible_function(required_param, default_param="default", *args, **kwargs):
    """
    *args captures extra positional arguments into a tuple.
    **kwargs captures extra keyword arguments into a dictionary.
    """
    print(f"Required: {required_param}")
    print(f"Default: {default_param}")
    print(f"Extra positional (*args): {args}")
    print(f"Extra keyword (**kwargs): {kwargs}")

flexible_function(1, "custom", 10, 20, debug=True, user="Admin")

# return multiple values

def min_max(numbers):
    return min(numbers), max(numbers)  # Returns tuple: (min, max)

lowest, highest = min_max([12, 45, 2, 89, 34])
print(lowest)
print(highest)

