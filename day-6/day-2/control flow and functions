#temperature converter

def convert_temperature(value, from_scale, to_scale="C"):

    # If both scales are the same, no math needed
    if from_scale == to_scale:
        return value

    # Step 1: Convert starting scale to Celsius
    if from_scale == "C":
        celsius = value
    elif from_scale == "F":
        celsius = (value - 32) * 5 / 9
    elif from_scale == "K":
        celsius = value - 273.15
    else:
        print("Invalid starting scale!")
        return None

    # Step 2: Convert Celsius to the target scale
    if to_scale == "C":
        return celsius
    elif to_scale == "F":
        return (celsius * 9 / 5) + 32
    elif to_scale == "K":
        return celsius + 273.15
    else:
        print("Invalid target scale!")
        return None


# Examples:
print(convert_temperature(100, "C", "F"))  # 212.0
print(convert_temperature(32, "F", "C"))   # 0.0
print(convert_temperature(0, "C", "K"))    # 273.15

