x = "Global X"  # Global Scope

def outer_function():
    x = "Enclosing X"  # Enclosing Scope
    
    def inner_function():
        x = "Local X"  # Local Scope
        print(x)       # Resolves to Local X
        
    inner_function()

outer_function()

#to modify a local scope to global scope using global keyword

counter = 0

def increment():
    global counter
    counter += 1

def fizz_buzz(limit: int) -> None:
    for i in range(1, limit + 1):
        if i % 3 == 0 and i % 5 == 0:
            print("FizzBuzz")
        elif i % 3 == 0:
            print("Fizz")
        elif i % 5 == 0:
            print("Buzz")
        else:
            print(i)

