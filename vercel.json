{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd \"final project complete/ecommerce_frontend\" && npm install && npm run build",
  "outputDirectory": "final project complete/ecommerce_frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/ecommerce_frontend/dist/index.html"
    }
  ]
}
